# SPARTA API Environment Configuration Example
PORT=8081
DATABASE_URL=postgresql://user:password@hostname:5432/building?sslmode=require
CORS_ORIGINS=https://building.sparta-alfamart.web.id

# Google Service Configuration
EMAIL_USER=building_development@sat.co.id
GOOGLE_DOC_TOKEN_PATH=/etc/secrets/token_doc.json
GOOGLE_TOKEN_PATH=/etc/secrets/token.json
MASTER_DRIVE_FOLDER_ID=your_master_drive_folder_id

# Security & Secrets (Wajib diisi di production)
SSO_JWT_SECRET=your_production_sso_jwt_secret_min_16_chars
SPARTA_INTERNAL_API_KEY=your_secure_internal_api_key_min_16_chars
AUTH_ENFORCEMENT_MODE=strict

# Postgres Pool & Timeouts
PG_CONN_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_KEEP_ALIVE=true
PG_POOL_MAX=20
